{
	"name": "frc-scoutingapp",
	"private": true,
	"version": "1.7.0",
	"type": "module",
	"description": "Scouting and match analysis for an FRC team at competition: match and pit scouting, strategy, rankings and a shared picklist.",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --output human --fail-on-warnings",
		"lint": "eslint .",
		"prepare": "svelte-kit sync || echo ''",
		"admin": "node --env-file-if-exists=.env scripts/admin.mjs",
		"docker:build": "docker build -f deploy/Dockerfile -t frc-scoutingapp ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"vite": "^6.2.6",
		"vitest": "^2.1.4"
	},
	"dependencies": {
		"@slack/web-api": "^6.12.0",
		"@supabase/supabase-js": "^2.50.0",
		"katex": "^0.19.0",
		"lucide-svelte": "^0.515.0",
		"svelte-dnd-action": "^0.9.79"
	}
}
