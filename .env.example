# Copy this file to .env and fill it in. .env is gitignored: never commit it.
# Everything here is read when the server starts, so restart it after a change.

# --- Required ---------------------------------------------------------------------------------------------

# Your Supabase project (Supabase dashboard > Project Settings > API). The URL and the anon (public) key are
# safe to show in the browser; row-level security in supabase/migrations protects the data.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The same project's service_role key. It bypasses row-level security, so it stays on the server: never put it
# in a PUBLIC_ variable, never send it to a browser, never commit it.
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional: only if the server should reach Supabase at a different address than the browser does.
# SUPABASE_URL=

# A long random secret that unlocks first-run setup (/setup). Whoever enters it becomes the first admin, so
# keep it private. Make one with:  openssl rand -base64 32
SETUP_TOKEN=change-me-to-a-long-random-secret

# The address people open the site at. Must match exactly (scheme, host and port).
APP_ORIGIN=http://localhost:5173

# The Blue Alliance read API key (thebluealliance.com > Account > Read API Keys). Schedules, teams, rankings,
# OPRs and match results all come from it.
TBA_API_KEY=your-tba-read-key

# --- Optional ---------------------------------------------------------------------------------------------

# Shared logins without a real mailbox: a bare username like "pit1" signs in as pit1@<this domain>.
# Defaults to scouting.local. Nothing is ever sent there.
# PUBLIC_USERNAME_EMAIL_DOMAIN=

# Slack: DMs scouts their assignments and match reminders, and posts pit problems to one channel.
# Leave empty to turn Slack off. The bot needs chat:write, im:write and users:read.email.
SLACK_BOT_TOKEN=
# Channel id (not the name) for pit problem alerts; invite the bot to it.
SLACK_PIT_PROBLEMS_CHANNEL=

# Ask the data (Analyze > AI analytics): one of these keys. Turn the page on in Scouting Admin > Team settings.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional overrides: ASSISTANT_PROVIDER=gemini|openai  ASSISTANT_MODEL=  ASSISTANT_BASE_URL=

# Google Sheets export (Scouting Admin > Event setup): a Google service account key, as JSON on one line.
# Share the sheet with the service account's email.
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# Daily data cleanup check (POST /api/scouting-admin/retention-cron with "Authorization: Bearer <CRON_SECRET>").
# It never deletes anything by itself; it tells admins when old data could be cleaned up.
CRON_SECRET=
# Limits in MB (default: 80% of the Supabase free plan, 400 database and 800 storage).
RETENTION_DB_LIMIT_MB=
RETENTION_STORAGE_LIMIT_MB=
